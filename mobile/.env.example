# Copy to .env.local (ignored by git). Only non-secret values: everything
# EXPO_PUBLIC_* is built into the app (docs/11 §7).

# Backend base URL, without /api/v1. Leave empty in development to use the
# computer running Metro on port 3000.
EXPO_PUBLIC_API_URL=

# Google sign-in (D-025): the *Web* OAuth client ID from Google Cloud. The
# backend's GOOGLE_CLIENT_IDS must contain the same value.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 1 = show "Log in with mobile number" outside development (testing only;
# the backend refuses SMS outside development until Q-08 is decided).
EXPO_PUBLIC_PHONE_LOGIN=
