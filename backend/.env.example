# Local PostgreSQL connection. Update the user and password once PostgreSQL is installed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaamsetu?schema=public"
PORT=3000

# Log format: json (staging/production default) or pretty (local default)
# LOG_FORMAT=pretty

# Auth secrets: at least 32 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-value-0000000000"
OTP_HASH_SECRET="change-me-to-another-long-random-value-00000"
