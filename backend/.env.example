# Local PostgreSQL connection. Update the user and password once PostgreSQL is installed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaamsetu?schema=public"
PORT=3000

# Log format: json (staging/production default) or pretty (local default)
# LOG_FORMAT=pretty

# Auth secrets: at least 32 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-value-0000000000"
OTP_HASH_SECRET="change-me-to-another-long-random-value-00000"

# Google sign-in (D-025): the Web OAuth client ID(s) from Google Cloud, comma-separated.
# Empty: POST /auth/google answers 503 GOOGLE_NOT_CONFIGURED.
GOOGLE_CLIENT_IDS=""

# Reverse proxies in front of the API (Render: 1). 0 or unset locally.
# TRUST_PROXY=1

# Public pages (/, /privacy, /terms): contact shown for privacy requests, and the
# Google Search Console HTML-tag code for domain verification. Optional.
# SUPPORT_EMAIL="support@example.com"
# SUPPORT_WHATSAPP="98xxxxxxxx"   # help from the app; unset = no WhatsApp row
# GOOGLE_SITE_VERIFICATION=""

# Sentry DSN for server error reports (docs/11 §6). Unset: no reporting.
# SENTRY_DSN=""
