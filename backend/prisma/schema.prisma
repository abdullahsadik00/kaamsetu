// KaamSetu database schema.
// Starts with the identity tables only (docs/05 section 1). Add the other
// domain tables as each feature is built.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MemberRole {
  OWNER
  SENIOR_TECHNICIAN
  HELPER
}

model Organization {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  phone        String
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  logoKey      String?
  gstin        String?
  /// Default for new bills: GST bill or not (prototype "We give GST bills"); each bill can still change it.
  gstBills     Boolean      @default(false)
  currencyCode String       @default("INR") @db.Char(3)
  timezone     String       @default("Asia/Kolkata")
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members           OrganizationMember[]
  subscription      Subscription?
  customers         Customer[]
  teams             Team[]
  jobs              ServiceJob[]
  /// Next job number for this business (#1001, #1002, …).
  nextJobNumber     Int                  @default(1001)
  enquiries         ServiceRequest[]
  /// Next enquiry number for this business (E-201, E-202, …).
  nextRequestNumber Int                  @default(201)
  invoices          Invoice[]
  /// Next bill number (KS-0001, KS-0002, …) and quotation number (Q-001, …), T4.10.
  nextBillNumber    Int                  @default(1)
  nextQuoteNumber   Int                  @default(1)
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// One per business (docs/03). Minimal until billing plans exist (D-027):
/// a new business gets a 30-day trial (D-014).
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @db.Uuid
  plan               String             @default("TRIAL")
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model User {
  id                String       @id @default(uuid()) @db.Uuid
  /// E.164, e.g. +919876501234 (docs/10 §1). Empty for a Google user who has not joined a business yet.
  phone             String?      @unique
  /// Google account id ("sub" claim) once linked (D-025). Never reused for another user.
  googleSubject     String?      @unique
  /// Empty until the user completes onboarding (module 4.1)
  name              String       @default("")
  email             String?
  preferredLanguage String       @default("en")
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  memberships OrganizationMember[]
  devices     Device[]
}

/// Owner's invitation linking a person's Google login to an employee record (D-025, docs/10 §2).
/// The QR carries a long random token; the manual fallback is phone + 6-digit code.
/// Both are stored only as HMAC hashes. Single use, expires after 24 h.
model MemberInvite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  memberId       String    @db.Uuid
  tokenHash      String    @unique
  codeHash       String
  attempts       Int       @default(0)
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())

  member OrganizationMember @relation(fields: [memberId], references: [id])

  @@index([memberId, createdAt])
  @@index([organizationId])
}

// ---------- Authentication (docs/10 §1) ----------

/// One SMS one-time password. Only a hash of the code is stored.
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// A phone the user logged in on. Revoking it ends that phone's session.
model Device {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  platform   String
  label      String?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
}

/// Rotating refresh token. Only a SHA-256 hash is stored; each token works once.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  deviceId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           MemberRole
  status         RecordStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  deactivatedAt  DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  invites      MemberInvite[]
  teamSlots    TeamMember[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
}

// ---------- Customers and ACs (docs/05 §3–4, T4.3/T4.4, D-028) ----------

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

/// A business's customer. Phone is not unique: the app warns on duplicates instead.
model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  type           CustomerType @default(INDIVIDUAL)
  name           String
  /// E.164, e.g. +919876501234
  phone          String
  alternatePhone String?
  notes          String?
  /// Default for this customer's bills (prototype "Give GST bills").
  gstBills       Boolean      @default(false)
  gstin          String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  sites        Site[]
  equipment    Equipment[]

  @@index([organizationId, phone])
  @@index([organizationId, name])
}

/// An address of a customer (home, office, shop). The first one is the default.
model Site {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  customerId     String   @db.Uuid
  label          String?
  addressLine1   String
  locality       String?
  city           String?
  landmark       String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer  Customer    @relation(fields: [customerId], references: [id])
  equipment Equipment[]

  @@index([organizationId, customerId])
}

enum EquipmentType {
  SPLIT
  WINDOW
  CASSETTE
  DUCTABLE
  TOWER
  OTHER
}

/// One AC unit at a site.
model Equipment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  customerId     String        @db.Uuid
  siteId         String        @db.Uuid
  type           EquipmentType @default(SPLIT)
  brand          String?
  /// Tons, e.g. 1.5. Null = not known.
  capacityTons   Decimal?      @db.Decimal(3, 1)
  /// Where it is, e.g. "Bedroom 1".
  locationLabel  String?
  model          String?
  serialNumber   String?
  refrigerant    String?
  status         RecordStatus  @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  site     Site     @relation(fields: [siteId], references: [id])

  @@index([organizationId, customerId])
  @@index([siteId])
}

// ---------- Teams (docs/05 §2, T4.2, D-029) ----------

enum TeamPosition {
  SENIOR_TECHNICIAN
  HELPER
}

/// A field team: one primary senior technician and helpers. Jobs are assigned to teams.
model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  members      TeamMember[]

  @@index([organizationId, active])
}

/// An employee's place in a team. Leaving sets leftAt (history is kept for jobs).
model TeamMember {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @db.Uuid
  teamId               String       @db.Uuid
  organizationMemberId String       @db.Uuid
  position             TeamPosition
  isPrimary            Boolean      @default(false)
  joinedAt             DateTime     @default(now())
  leftAt               DateTime?

  team   Team               @relation(fields: [teamId], references: [id])
  member OrganizationMember @relation(fields: [organizationMemberId], references: [id])

  @@index([teamId, leftAt])
  @@index([organizationMemberId, leftAt])
}

// ---------- Jobs (docs/05 §5, T4.6, D-030) ----------

enum JobType {
  SERVICE
  REPAIR
  INSTALLATION
  UNINSTALLATION
  GAS_FILLING
  OTHER
}

enum JobStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
}

/// One visit / work order. Status changes go through the state machine (jobs.state.ts).
model ServiceJob {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  jobNumber         Int
  customerId        String    @db.Uuid
  siteId            String    @db.Uuid
  type              JobType   @default(SERVICE)
  complaint         String?
  /// Day of the visit (calendar date, organization time zone).
  scheduledDate     DateTime? @db.Date
  timeSlot          TimeSlot?
  assignedTeamId    String?   @db.Uuid
  status            JobStatus @default(NEW)
  /// Paise (docs/11 §3).
  amountToCollect   Int?
  cancelReason      String?
  followUpOfJobId   String?   @db.Uuid
  /// The enquiry this job was made from (T4.5); one enquiry gives at most one job.
  serviceRequestId  String?   @unique @db.Uuid
  createdByMemberId String    @db.Uuid
  version           Int       @default(1)
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  equipment    JobEquipment[]
  assignments  JobAssignment[]
  history      JobStatusHistory[]
  report       ServiceReport?
  collections  CashCollection[]

  @@unique([organizationId, jobNumber])
  @@index([organizationId, status, scheduledDate])
  @@index([organizationId, assignedTeamId])
  @@index([organizationId, customerId])
}

model JobEquipment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  jobId          String @db.Uuid
  equipmentId    String @db.Uuid

  job ServiceJob @relation(fields: [jobId], references: [id])

  @@unique([jobId, equipmentId])
}

/// Team assignment history; the current one has unassignedAt = null.
model JobAssignment {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  jobId              String    @db.Uuid
  teamId             String    @db.Uuid
  assignedByMemberId String    @db.Uuid
  assignedAt         DateTime  @default(now())
  unassignedAt       DateTime?

  job ServiceJob @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

model JobStatusHistory {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  jobId          String     @db.Uuid
  fromStatus     JobStatus?
  toStatus       JobStatus
  byMemberId     String     @db.Uuid
  note           String?
  at             DateTime   @default(now())

  job ServiceJob @relation(fields: [jobId], references: [id])

  @@index([jobId, at])
}

// ---------- Enquiries (docs/05 §5, T4.5, D-033) ----------

enum EnquirySource {
  WHATSAPP
  PHONE
  WALK_IN
  SERVICE_CENTRE
  B2B
  OTHER
}

enum EnquiryStatus {
  OPEN
  CONVERTED
  CLOSED
}

/// A customer's request before it becomes a job (shown as E-213).
model ServiceRequest {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @db.Uuid
  requestNumber     Int
  customerId        String        @db.Uuid
  siteId            String        @db.Uuid
  source            EnquirySource @default(WHATSAPP)
  type              JobType       @default(SERVICE)
  complaint         String?
  /// Customer's preferred day (calendar date) and time.
  preferredDate     DateTime?     @db.Date
  preferredSlot     TimeSlot?
  status            EnquiryStatus @default(OPEN)
  closeReason       String?
  createdByMemberId String        @db.Uuid
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id])
  equipment    ServiceRequestEquipment[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status, createdAt])
}

model ServiceRequestEquipment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  requestId      String @db.Uuid
  equipmentId    String @db.Uuid

  request ServiceRequest @relation(fields: [requestId], references: [id])

  @@unique([requestId, equipmentId])
}

// ---------- Sync (docs/09 §5–6, T4.7, D-031) ----------

/// An outbox operation the server has processed. Same id again = duplicate
/// (the stored result is returned); kept at least 30 days (docs/09 §6).
model SyncOperation {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  memberId       String   @db.Uuid
  operation      String
  entityId       String   @db.Uuid
  /// Hash of the operation body, to reject the same id with different content.
  payloadHash    String
  result         String
  errorCode      String?
  receivedAt     DateTime @default(now())

  @@index([organizationId, receivedAt])
}

enum ReportOutcome {
  COMPLETED
  NEEDS_FOLLOW_UP
  NOT_COMPLETED
}

enum CollectionMode {
  CASH
  UPI
}

enum CollectionStatus {
  /// Recorded by the team; not yet a payment (D-008).
  WITH_TEAM
  /// Owner confirmed the handover (cash received / UPI seen).
  CONFIRMED
  /// Owner says the money did not reach them (reason kept).
  REJECTED
}

/// The finish page (T4.8, D-032). Id = the phone's job.complete operation id.
model ServiceReport {
  id             String        @id @db.Uuid
  organizationId String        @db.Uuid
  jobId          String        @unique @db.Uuid
  byMemberId     String        @db.Uuid
  outcome        ReportOutcome
  note           String?
  /// Work per AC: [{ equipmentId, work: ["CLEANED", ...], note? }].
  work           Json          @default("[]")
  /// Parts used: [{ name, qty }].
  parts          Json          @default("[]")
  createdAt      DateTime      @default(now())

  job ServiceJob @relation(fields: [jobId], references: [id])

  @@index([organizationId, createdAt])
}

/// Money a team took from the customer (D-008); a payment only after the owner confirms.
model CashCollection {
  id                  String           @id @db.Uuid
  organizationId      String           @db.Uuid
  jobId               String           @db.Uuid
  collectedByMemberId String           @db.Uuid
  /// Paise (docs/11 §3).
  amount              Int
  mode                CollectionMode
  status              CollectionStatus @default(WITH_TEAM)
  confirmedByMemberId String?          @db.Uuid
  confirmedAt         DateTime?
  rejectReason        String?
  /// The payment made from it on the job's bill, when there was one (T4.11).
  paymentId           String?          @unique @db.Uuid
  createdAt           DateTime         @default(now())

  job ServiceJob @relation(fields: [jobId], references: [id])

  @@index([organizationId, status])
  @@index([jobId])
}

// ---------- Billing (docs/05 §7, T4.10/T4.11, D-034) ----------

enum InvoiceKind {
  BILL
  QUOTATION
}

/// One status list for bills and quotations. A bill: DRAFT → ISSUED (final,
/// cannot change) → CANCELLED. A quotation: DRAFT → ISSUED ("sent") →
/// CONVERTED (turned into a bill) or CANCELLED.
enum InvoiceStatus {
  DRAFT
  ISSUED
  CONVERTED
  CANCELLED
}

/// A bill (KS-0001) or a written quotation (Q-001). Money in paise; the
/// server recalculates every total from the lines (never trusts the phone).
model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @db.Uuid
  kind              InvoiceKind
  /// Per business and kind; shown as KS-0001 or Q-001.
  number            Int
  status            InvoiceStatus @default(DRAFT)
  customerId        String        @db.Uuid
  siteId            String?       @db.Uuid
  jobId             String?       @db.Uuid
  /// Same as jobId while this is the job's bill; cleared on cancel so the job can be billed again.
  billForJobId      String?       @unique @db.Uuid
  /// The quotation this bill was made from, or the bill a quotation became.
  fromQuotationId   String?       @unique @db.Uuid
  convertedToBillId String?       @db.Uuid
  billDate          DateTime      @db.Date
  /// GST per line, CGST + SGST (intra-state only); provisional until Q-04.
  gstBill           Boolean       @default(false)
  sellerGstin       String?
  buyerGstin        String?
  discount          Int           @default(0)
  subtotal          Int           @default(0)
  taxTotal          Int           @default(0)
  total             Int           @default(0)
  /// Sum of payments not voided (kept in the same transaction as each payment).
  paid              Int           @default(0)
  issuedAt          DateTime?
  cancelReason      String?
  cancelledAt       DateTime?
  createdByMemberId String        @db.Uuid
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, kind, number])
  @@index([organizationId, kind, status, billDate])
  @@index([organizationId, customerId])
  @@index([jobId])
}

/// One line of a bill or quotation. Description and prices are snapshots.
model InvoiceItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  invoiceId      String @db.Uuid
  position       Int
  description    String
  qty            Int
  /// Paise for one.
  unitPrice      Int
  /// Percent: 0, 5, 12, 18 or 28 (0 when the bill is not a GST bill).
  gstRate        Int    @default(0)
  /// qty × unitPrice, before discount and tax.
  amount         Int
  /// Share of the bill discount, then tax on what is left.
  discountShare  Int    @default(0)
  cgst           Int    @default(0)
  sgst           Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId, position])
}

enum PaymentMode {
  CASH
  UPI
  BANK
  OTHER
}

/// Money received against one bill (one payment → one bill for now).
/// Voiding keeps the row and the reason (audit).
model Payment {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @db.Uuid
  invoiceId          String      @db.Uuid
  customerId         String      @db.Uuid
  amount             Int
  mode               PaymentMode
  receivedAt         DateTime    @db.Date
  note               String?
  /// Phone-generated; the same key again returns the same payment.
  idempotencyKey     String
  recordedByMemberId String      @db.Uuid
  voidedAt           DateTime?
  voidReason         String?
  voidedByMemberId   String?     @db.Uuid
  createdAt          DateTime    @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, customerId])
  @@index([invoiceId])
}
