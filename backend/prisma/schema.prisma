// KaamSetu database schema.
// Starts with the identity tables only (docs/05 section 1). Add the other
// domain tables as each feature is built.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MemberRole {
  OWNER
  SENIOR_TECHNICIAN
  HELPER
}

model Organization {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  phone        String
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  logoKey      String?
  gstin        String?
  currencyCode String       @default("INR") @db.Char(3)
  timezone     String       @default("Asia/Kolkata")
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members OrganizationMember[]
}

model User {
  id                String       @id @default(uuid()) @db.Uuid
  /// E.164, e.g. +919876501234 (docs/10 §1)
  phone             String       @unique
  /// Empty until the user completes onboarding (module 4.1)
  name              String       @default("")
  email             String?
  preferredLanguage String       @default("en")
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  memberships OrganizationMember[]
  devices     Device[]
}

// ---------- Authentication (docs/10 §1) ----------

/// One SMS one-time password. Only a hash of the code is stored.
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// A phone the user logged in on. Revoking it ends that phone's session.
model Device {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  platform   String
  label      String?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
}

/// Rotating refresh token. Only a SHA-256 hash is stored; each token works once.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  deviceId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           MemberRole
  status         RecordStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  deactivatedAt  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId, status])
}
